  "cues": [
    {
      "start": 0,
      "end": 39,
      "text": "Un juego acaba de igualar",
      "clip": 1
    },
    {
      "start": 39,
      "end": 93,
      "text": "un récord de 28 años.",
      "clip": 1
    },
    {
      "start": 102,
      "end": 114,
      "text": "Es",
      "clip": 1
    },
    {
      "start": 122,
      "end": 187,
      "text": "GTA 6, y las reseñas son",
      "clip": 1
    },
    {
      "start": 187,
      "end": 211,
      "text": "históricas,",
      "clip": 1
    },
    {
      "start": 220,
      "end": 255,
      "text": "pero tiene pegas que casi",
      "clip": 1
    },
    {
      "start": 255,
      "end": 275,
      "text": "nadie cuenta.",
      "clip": 1
    },
    {
      "start": 286,
      "end": 319,
      "text": "Bienvenido a Zinko,",
      "clip": 2
    },
    {
      "start": 320,
      "end": 354,
      "text": "el canal de la curiosidad.",
      "clip": 2
    },
    {
      "start": 363,
      "end": 394,
      "text": "Hoy veremos qué aman,",
      "clip": 2
    },
    {
      "start": 401,
      "end": 441,
      "text": "qué critican y si valió",
      "clip": 2
    },
    {
      "start": 441,
      "end": 456,
      "text": "la espera,",
      "clip": 2
    },
    {
      "start": 465,
      "end": 513,
      "text": "y al final mi veredicto.",
      "clip": 2
    },
    {
      "start": 520,
      "end": 568,
      "text": "Las reseñas salieron con una",
      "clip": 3
    },
    {
      "start": 568,
      "end": 617,
      "text": "nota casi perfecta,",
      "clip": 3
    },
    {
      "start": 627,
      "end": 704,
      "text": "99 sobre 100 en Metacritic,",
      "clip": 3
    },
    {
      "start": 714,
      "end": 782,
      "text": "más de 140 críticos lo",
      "clip": 3
    },
    {
      "start": 782,
      "end": 800,
      "text": "puntuaron.",
      "clip": 3
    },
    {
      "start": 808,
      "end": 846,
      "text": "Solo un juego había llegado",
      "clip": 4
    },
    {
      "start": 846,
      "end": 867,
      "text": "a 99.",
      "clip": 4
    },
    {
      "start": 879,
      "end": 910,
      "text": "Ocarina of Time,",
      "clip": 4
    },
    {
      "start": 923,
      "end": 960,
      "text": "de 1998.",
      "clip": 4
    },
    {
      "start": 973,
      "end": 1012,
      "text": "28 años después,",
      "clip": 4
    },
    {
      "start": 1020,
      "end": 1056,
      "text": "GTA 6 lo alcanza.",
      "clip": 4
    },
    {
      "start": 1065,
      "end": 1084,
      "text": "En la saga,",
      "clip": 5
    },
    {
      "start": 1097,
      "end": 1154,
      "text": "GTA 4 tiene 98,",
      "clip": 5
    },
    {
      "start": 1166,
      "end": 1191,
      "text": "GTA 5,",
      "clip": 5
    },
    {
      "start": 1200,
      "end": 1261,
      "text": "97, y en el recuento",
      "clip": 5
    },
    {
      "start": 1261,
      "end": 1297,
      "text": "inicial no había ni una",
      "clip": 5
    },
    {
      "start": 1297,
      "end": 1326,
      "text": "reseña negativa.",
      "clip": 5
    },
    {
      "start": 1335,
      "end": 1371,
      "text": "Lo primero que alaban es",
      "clip": 6
    },
    {
      "start": 1371,
      "end": 1399,
      "text": "el mundo abierto,",
      "clip": 6
    },
    {
      "start": 1409,
      "end": 1447,
      "text": "enorme,",
      "clip": 6
    },
    {
      "start": 1459,
      "end": 1507,
      "text": "vivo y lleno de detalles.",
      "clip": 6
    },
    {
      "start": 1517,
      "end": 1557,
      "text": "Dicen que te hace sentir",
      "clip": 6
    },
    {
      "start": 1557,
      "end": 1583,
      "text": "dentro de él.",
      "clip": 6
    },
    {
      "start": 1592,
      "end": 1641,
      "text": "Los dos protagonistas son lo",
      "clip": 7
    },
    {
      "start": 1641,
      "end": 1683,
      "text": "más elogiado de la historia.",
      "clip": 7
    },
    {
      "start": 1694,
      "end": 1717,
      "text": "Una pareja que,",
      "clip": 7
    },
    {
      "start": 1721,
      "end": 1749,
      "text": "según los críticos,",
      "clip": 7
    },
    {
      "start": 1758,
      "end": 1787,
      "text": "se siente creíble,",
      "clip": 7
    },
    {
      "start": 1797,
      "end": 1824,
      "text": "y que tú ayudas a",
      "clip": 7
    },
    {
      "start": 1824,
      "end": 1866,
      "text": "moldear con tus decisiones.",
      "clip": 7
    },
    {
      "start": 1875,
      "end": 1922,
      "text": "La historia principal dura unas",
      "clip": 8
    },
    {
      "start": 1922,
      "end": 1948,
      "text": "60 horas.",
      "clip": 8
    },
    {
      "start": 1959,
      "end": 2002,
      "text": "Y con todo lo demás",
      "clip": 8
    },
    {
      "start": 2002,
      "end": 2032,
      "text": "pasa de 100.",
      "clip": 8
    },
    {
      "start": 2044,
      "end": 2090,
      "text": "Es muchísimo juego por lo",
      "clip": 8
    },
    {
      "start": 2090,
      "end": 2106,
      "text": "que cuesta.",
      "clip": 8
    },
    {
      "start": 2116,
      "end": 2193,
      "text": "IGN, GameSpot y Eurogamer le",
      "clip": 9
    },
    {
      "start": 2193,
      "end": 2249,
      "text": "dieron la nota máxima.",
      "clip": 9
    },
    {
      "start": 2249,
      "end": 2282,
      "text": "Uno de ellos lo llamó",
      "clip": 9
    },
    {
      "start": 2282,
      "end": 2327,
      "text": "el juego de la generación.",
      "clip": 9
    },
    {
      "start": 2338,
      "end": 2378,
      "text": "Las notas más bajas rondan",
      "clip": 9
    },
    {
      "start": 2378,
      "end": 2397,
      "text": "el ochenta.",
      "clip": 9
    },
    {
      "start": 2406,
      "end": 2445,
      "text": "Ahora, las pegas.",
      "clip": 10
    },
    {
      "start": 2455,
      "end": 2487,
      "text": "La más repetida,",
      "clip": 10
    },
    {
      "start": 2495,
      "end": 2540,
      "text": "30 fotogramas por segundo.",
      "clip": 10
    },
    {
      "start": 2551,
      "end": 2581,
      "text": "En todas las consolas,",
      "clip": 10
    },
    {
      "start": 2588,
      "end": 2628,
      "text": "incluso en PS5 Pro.",
      "clip": 10
    },
    {
      "start": 2640,
      "end": 2665,
      "text": "Y sin un modo de",
      "clip": 10
    },
    {
      "start": 2665,
      "end": 2677,
      "text": "60.",
      "clip": 10
    },
    {
      "start": 2689,
      "end": 2748,
      "text": "Varias reseñas notan caídas de",
      "clip": 11
    },
    {
      "start": 2748,
      "end": 2765,
      "text": "rendimiento,",
      "clip": 11
    },
    {
      "start": 2776,
      "end": 2810,
      "text": "sobre todo en zonas muy",
      "clip": 11
    },
    {
      "start": 2810,
      "end": 2849,
      "text": "llenas y en tiroteos,",
      "clip": 11
    },
    {
      "start": 2860,
      "end": 2900,
      "text": "aunque otros críticos lo ven",
      "clip": 11
    },
    {
      "start": 2900,
      "end": 2934,
      "text": "fluido y estable.",
      "clip": 11
    },
    {
      "start": 2943,
      "end": 2993,
      "text": "También critican un ritmo desigual",
      "clip": 12
    },
    {
      "start": 2993,
      "end": 3014,
      "text": "en la historia.",
      "clip": 12
    },
    {
      "start": 3025,
      "end": 3084,
      "text": "Un inicio lento y misiones",
      "clip": 12
    },
    {
      "start": 3084,
      "end": 3105,
      "text": "muy guiadas,",
      "clip": 12
    },
    {
      "start": 3116,
      "end": 3154,
      "text": "y escenas largas en las",
      "clip": 12
    },
    {
      "start": 3154,
      "end": 3191,
      "text": "que casi no controlas.",
      "clip": 12
    },
    {
      "start": 3200,
      "end": 3245,
      "text": "Y el Realismo tiene curva",
      "clip": 13
    },
    {
      "start": 3245,
      "end": 3271,
      "text": "de aprendizaje.",
      "clip": 13
    },
    {
      "start": 3282,
      "end": 3320,
      "text": "Coches más frágiles,",
      "clip": 13
    },
    {
      "start": 3330,
      "end": 3365,
      "text": "gastos y tareas del día",
      "clip": 13
    },
    {
      "start": 3365,
      "end": 3374,
      "text": "a día.",
      "clip": 13
    },
    {
      "start": 3385,
      "end": 3424,
      "text": "Si vienes de GTA 5,",
      "clip": 13
    },
    {
      "start": 3430,
      "end": 3456,
      "text": "te sorprenderá.",
      "clip": 13
    },
    {
      "start": 3464,
      "end": 3506,
      "text": "Las preventas superaron lo",
      "clip": 14
    },
    {
      "start": 3511,
      "end": 3552,
      "text": "esperado, dice Take-Two,",
      "clip": 14
    },
    {
      "start": 3563,
      "end": 3607,
      "text": "Sensor Tower calcula más de",
      "clip": 14
    },
    {
      "start": 3607,
      "end": 3635,
      "text": "17 millones,",
      "clip": 14
    },
    {
      "start": 3646,
      "end": 3681,
      "text": "a casi 80 o casi",
      "clip": 14
    },
    {
      "start": 3681,
      "end": 3721,
      "text": "100 dólares cada una.",
      "clip": 14
    },
    {
      "start": 3730,
      "end": 3758,
      "text": "Para comparar,",
      "clip": 15
    },
    {
      "start": 3763,
      "end": 3817,
      "text": "GTA 5 vendió 11 millones",
      "clip": 15
    },
    {
      "start": 3817,
      "end": 3845,
      "text": "el primer día.",
      "clip": 15
    },
    {
      "start": 3854,
      "end": 3895,
      "text": "Según esa estimación,",
      "clip": 15
    },
    {
      "start": 3905,
      "end": 3956,
      "text": "las preventas ya lo superan,",
      "clip": 15
    },
    {
      "start": 3967,
      "end": 4018,
      "text": "faltan las cifras oficiales",
      "clip": 15
    },
    {
      "start": 4027,
      "end": 4064,
      "text": "Superó las expectativas,",
      "clip": 16
    },
    {
      "start": 4076,
      "end": 4100,
      "text": "para los críticos,",
      "clip": 16
    },
    {
      "start": 4106,
      "end": 4112,
      "text": "sí,",
      "clip": 16
    },
    {
      "start": 4123,
      "end": 4156,
      "text": "para algunos jugadores hay",
      "clip": 16
    },
    {
      "start": 4156,
      "end": 4198,
      "text": "matices, sobre todo con los",
      "clip": 16
    },
    {
      "start": 4198,
      "end": 4228,
      "text": "30 fotogramas.",
      "clip": 16
    },
    {
      "start": 4239,
      "end": 4257,
      "text": "Y aún así,",
      "clip": 16
    },
    {
      "start": 4263,
      "end": 4308,
      "text": "el aplauso es casi unánime.",
      "clip": 16
    },
    {
      "start": 4316,
      "end": 4383,
      "text": "Mi veredicto no es perfecto,",
      "clip": 17
    },
    {
      "start": 4390,
      "end": 4422,
      "text": "pero es histórico.",
      "clip": 17
    },
    {
      "start": 4433,
      "end": 4473,
      "text": "Las pegas son técnicas y",
      "clip": 17
    },
    {
      "start": 4473,
      "end": 4487,
      "text": "de ritmo,",
      "clip": 17
    },
    {
      "start": 4492,
      "end": 4511,
      "text": "no de ambición,",
      "clip": 17
    },
    {
      "start": 4523,
      "end": 4554,
      "text": "y la última palabra la",
      "clip": 17
    },
    {
      "start": 4554,
      "end": 4569,
      "text": "tienes tú,",
      "clip": 17
    },
    {
      "start": 4581,
      "end": 4597,
      "text": "jugándolo.",
      "clip": 17
    },
    {
      "start": 4608,
      "end": 4656,
      "text": "¿Qué nota le pondrías tú,",
      "clip": 18
    },
    {
      "start": 4659,
      "end": 4686,
      "text": "a GTA 6?",
      "clip": 18
    },
    {
      "start": 4697,
      "end": 4739,
      "text": "Suscríbete a Zinko para más",
      "clip": 18
    },
    {
      "start": 4739,
      "end": 4763,
      "text": "curiosidad.",
      "clip": 18
    },
    {
      "start": 4774,
      "end": 4809,
      "text": "Y mira el siguiente vídeo,",
      "clip": 18
    },
    {
      "start": 4812,
      "end": 4835,
      "text": "está justo aquí.",
      "clip": 18
    }
  ],
